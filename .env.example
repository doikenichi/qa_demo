# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.
# See NFR-005 and the Staff credential section of appointment-booking-project.md.

# Staff API token — required for all staff-credentialed endpoints.
STAFF_API_TOKEN=replace-with-a-real-token

# Application time zone. Must be a valid IANA zone name.
APP_TIME_ZONE=Europe/Berlin

# Hosted telemetry backend (Grafana Cloud OTLP endpoint and token).
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-0.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic replace-with-base64-encoded-instanceid:token

# Hosted static-analysis token (SonarCloud).
SONAR_TOKEN=replace-with-sonarcloud-token
