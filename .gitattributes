# Normalize all text to LF in the repository, whatever the author's platform.
# CI runs on Linux: a CRLF `gradlew` or shell script fails at the shebang, and
# Spotless/Biome see every line as modified. See NFR-012.
* text=auto eol=lf

# Scripts that must keep platform-native endings.
*.bat    text eol=crlf
*.cmd    text eol=crlf
gradlew  text eol=lf

# Binary — never touched.
*.jar    binary
*.png    binary
*.jpg    binary
*.gif    binary
*.ico    binary
*.woff   binary
*.woff2  binary
